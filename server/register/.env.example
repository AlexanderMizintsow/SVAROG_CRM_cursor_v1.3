# Скопируйте в .env и подставьте свои значения. На другом ПК замените localhost на IP (например 192.168.57.112).

DB_USER=postgres
DB_HOST=localhost
DB_NAME=Svarog
DB_PASSWORD=postgres
DB_PORT=5432
JWT_SECRET=your-secret

# Движок бизнес-процессов (BPE). Register шлёт сюда webhooks task-updated / project-updated.
# Локально: http://localhost:5010  |  На другом ПК: http://192.168.57.112:5010
BPE_API_URL=http://localhost:5010

# Допустимые origin для CORS и Socket.io (через запятую). Добавьте IP фронта при деплое на другой ПК.
# Пример: http://192.168.57.112:5173,http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://192.168.57.112:5173
