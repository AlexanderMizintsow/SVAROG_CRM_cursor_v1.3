{
  "name": "asterisk-server",
  "version": "1.0.0",
  "description": "Asterisk AMI client for call notifications",
  "main": "Asterisk.js",
  "scripts": {
    "start": "node Asterisk.js",
    "dev": "nodemon Asterisk.js",
    "test-call": "node simulate-call.js",
    "replay-call": "node replay-call-card.js",
    "replay-originate": "node replay-originate.js",
    "replay-window": "node replay-call-window.js",
    "replay-followup": "node ../CRM-server/replay-call-followup.js",
    "replay-silence": "node ../CRM-server/replay-call-silence.js",
